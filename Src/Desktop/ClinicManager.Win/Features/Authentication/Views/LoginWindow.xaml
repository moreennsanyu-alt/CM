<dx:ThemedWindow x:Class="ClinicManager.Win.Features.Authentication.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                 Icon="{dx:DXImage 'SvgImages/XAF/Action_Logoff.svg'}"
                 WindowStartupLocation="CenterScreen"
                 AutomationProperties.AutomationId="LoginWindow"
                 ResizeMode="NoResize"
                 mc:Ignorable="d"
                 Title="Login"
                 Height="290"
                 Width="450">
    <mvvm:Interaction.Behaviors>
        <mvvm:CurrentWindowService />
    </mvvm:Interaction.Behaviors>
    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Enter Viewer to log in with read-only access"
                   Margin="50,0" />
        <dxe:TextEdit EditValue="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                      Label="Username"
                      Margin="50,5" 
                      AutomationProperties.AutomationId="UsernameTextBox" />
        <dxe:PasswordBoxEdit EditValue="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             ShowPasswordButtonVisibility="Auto"
                             Label="Password"
                             Margin="50,5" 
                             AutomationProperties.AutomationId="PasswordTextBox" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#F44336"
                   Margin="50,0" 
                   AutomationProperties.AutomationId="LoginStatusLabel"/>
        <dx:SimpleButton Content="Login"
                         AsyncDisplayMode="Wait"
                         Command="{Binding LoginCommand}"
                         IsDefault="True"
                         Height="40"
                         Margin="50,20" 
                         AutomationProperties.AutomationId="LoginButton" />
        <dx:SimpleButton Content="cancel"
                         AsyncDisplayMode="Wait"
                         Command="{Binding CancelLoginCommand}"
                         IsDefault="False"
                         Height="40"
                         Margin="50,20" 
                         AutomationProperties.AutomationId="CancelButton" />

  </StackPanel>
</dx:ThemedWindow>

