<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- This is a shared library, not a test project: opt back out of the
         test/Directory.Build.props defaults (Exe/NUnit runner/IsTestProject). -->
    <IsTestProject>false</IsTestProject>
    <EnableNUnitRunner>false</EnableNUnitRunner>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ClinicManager.Testing</RootNamespace>
    <AssemblyName>ClinicManager.Testing</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Prism.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClinicManager.Core\ClinicManager.Core.csproj" />
  </ItemGroup>

</Project>
