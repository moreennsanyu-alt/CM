    <PackageVersion Include="Syncfusion.SfTreeGrid.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfPivotGrid.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfDataPager.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Data.WPF" Version="$(SyncfusionVersion)" />
    
    <!-- ========================================
