    <PackageVersion Include="Syncfusion.Themes.Office2016White.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Themes.Office2016BlackGray.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Themes.Windows11Light.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Themes.Windows11Dark.WPF" Version="$(SyncfusionVersion)" />
    
    <!-- ========================================
