    <PackageVersion Include="Syncfusion.XlsIO.Base" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.XlsIO.FlowAnalysis" Version="$(SyncfusionVersion)" />
    
    <!-- PDF Processing & Viewing -->
    <PackageVersion Include="Syncfusion.Pdf.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Pdf.Base" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.PdfViewer.WPF" Version="$(SyncfusionVersion)" />
    
    <!-- PowerPoint/Presentation -->
    <PackageVersion Include="Syncfusion.Presentation.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Presentation.Base" Version="$(SyncfusionVersion)" />
    
    <!-- ========================================
