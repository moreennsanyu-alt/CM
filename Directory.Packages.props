         ======================================== -->
    <PackageVersion Include="Syncfusion.Reporting.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.ReportWriter" Version="$(SyncfusionVersion)" />
    
    <!-- ========================================
