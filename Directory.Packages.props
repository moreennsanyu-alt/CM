    <PackageVersion Include="Syncfusion.SfRangeSlider.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfColorPicker.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfBusyIndicator.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfProgressBar.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfNumericUpDown.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfMaskedTextBox.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfComboBox.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfAutoComplete.WPF" Version="$(SyncfusionVersion)" />
    
    <!-- ========================================
         THEMING & STYLING
         ======================================== -->
    <PackageVersion Include="Syncfusion.SfSkinManager.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Themes.MaterialLight.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Themes.MaterialDark.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Themes.FluentLight.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Themes.FluentDark.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Themes.Office2019Colorful.WPF" Version="$(SyncfusionVersion)" />
