         ======================================== -->
    <PackageVersion Include="Syncfusion.SfScheduler.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfCalendar.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfDatePicker.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfTimePicker.WPF" Version="$(SyncfusionVersion)" />
    
    <!-- ========================================
