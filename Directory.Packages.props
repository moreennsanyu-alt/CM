<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <PrismVersion>8.1.97</PrismVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prism -->
    <PackageVersion Include="Prism.Core" Version="$(PrismVersion)" />
    <PackageVersion Include="Prism.Wpf" Version="$(PrismVersion)" />
    <PackageVersion Include="Prism.DryIoc" Version="$(PrismVersion)" />

    <!-- Test SDK / MTP -->
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.6.0" />

    <!-- Test doubles / assertions / data -->
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="Bogus" Version="35.6.1" />
  </ItemGroup>

</Project>
