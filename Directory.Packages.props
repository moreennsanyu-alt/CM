    <PackageVersion Include="Syncfusion.SfRibbon.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfRadialMenu.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfAccordion.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfNavigationDrawer.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfTabControlExt.WPF" Version="$(SyncfusionVersion)" />
    
    <!-- ========================================
